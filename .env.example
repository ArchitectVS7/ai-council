# Neon Postgres connection string
DATABASE_URL=
# anthropic | openai | local | mock
LLM_PROVIDER=anthropic
# default: claude-sonnet-5
LLM_MODEL=claude-sonnet-5
# required when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# required when LLM_PROVIDER=openai
OPENAI_API_KEY=
# read only when LLM_PROVIDER=local; the OpenAI-compatible base, no key is sent
# default: http://localhost:11434/v1 (the Ollama default)
LLM_BASE_URL=http://localhost:11434/v1
